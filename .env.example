# ---- Aurora Intelligence configuration ----
# Copy to `.env` and fill in real values. `.env` is git-ignored.

# Storage backend.
#   mongodb://localhost:27017  -> real MongoDB (default / production)
#   mock                       -> in-memory mongomock (dev only; resets each process)
MONGO_URI=mongodb://localhost:27017

# Logical database name inside MongoDB.
AURORA_DB_NAME=aurora_intelligence

# Optional: override the local Milvus Lite db file.
MILVUS_DB_PATH=milvus_rag.db

# ---- LLM providers (model router). Set at least one to enable live investigation.
# Groq (primary)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# NVIDIA NIM (optional)
NVIDIA_NIM_KEY=
